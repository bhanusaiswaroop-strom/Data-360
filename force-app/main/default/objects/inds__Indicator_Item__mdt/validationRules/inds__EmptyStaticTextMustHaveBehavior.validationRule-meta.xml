<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>inds__EmptyStaticTextMustHaveBehavior</fullName>
    <active>true</active>
    <description>Require a behavior when static text is empty.</description>
    <errorConditionFormula>ISPICKVAL(inds__Empty_Static_Text_Behavior__c,&apos;&apos;) &amp;&amp; ISBLANK(inds__Static_Text__c)</errorConditionFormula>
    <errorDisplayField>inds__Empty_Static_Text_Behavior__c</errorDisplayField>
    <errorMessage>If Static Text field is empty, please select a behavior for the indicator.</errorMessage>
</ValidationRule>
