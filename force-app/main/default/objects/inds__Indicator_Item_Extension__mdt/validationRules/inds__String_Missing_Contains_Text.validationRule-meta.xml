<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>inds__String_Missing_Contains_Text</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK( inds__Contains_Text__c )
&amp;&amp; (
    CONTAINS(inds__Indicator_Item__r.inds__Field__r.DataType,&apos;Text&apos;)
    || CONTAINS(inds__Indicator_Item__r.inds__Field__r.DataType,&apos;Picklist&apos;)
)</errorConditionFormula>
    <errorDisplayField>inds__Contains_Text__c</errorDisplayField>
    <errorMessage>Indicator Item is a String/Picklist Type and requires a Contains Text value</errorMessage>
</ValidationRule>
